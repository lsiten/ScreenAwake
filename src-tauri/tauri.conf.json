{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenAwake",
  "version": "0.1.2",
  "identifier": "com.screenawake.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ScreenAwake", "width": 720, "height": 760, "minWidth": 420, "minHeight": 600, "resizable": true },
      { "label": "keepalive", "title": "ScreenAwake Keepalive", "url": "index.html", "width": 1, "height": 1, "visible": false, "decorations": false, "skipTaskbar": true, "focus": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "wix": { "language": ["zh-CN"] } }
  }
}
